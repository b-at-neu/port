{
  "extraKnownMarketplaces": {
    "port": {
      "source": {
        "source": "github",
        "repo": "b-at-neu/port",
        "ref": "main"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "port@port": true
  },
  "permissions": {
    "allow": [
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(pnpm *)",
      "Bash(grep)",
      "Bash(grep *)",
      "Bash(egrep)",
      "Bash(egrep *)",
      "Bash(rg)",
      "Bash(rg *)",
      "Bash(find)",
      "Bash(find *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(wc)",
      "Bash(wc *)",
      "Bash(sort)",
      "Bash(sort *)",
      "Bash(uniq)",
      "Bash(uniq *)",
      "Bash(stat)",
      "Bash(stat *)",
      "Bash(file)",
      "Bash(file *)",
      "Bash(pwd)",
      "Bash(pwd *)",
      "Bash(mkdir -p *)",
      "Edit(**)",
      "Write(**)",
      "Read(~/.claude/plugins/**)",
      "WebFetch(domain:code.claude.com)",
      "Bash(node scripts/checks.mjs)",
      "Bash(node plugins/port/templates/artifacts.mjs *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh issue delete *)",
      "Bash(gh repo delete *)",
      "Bash(gh auth *)",
      "Bash(pnpm publish *)",
      "Bash(pnpm login *)",
      "Bash(pnpm adduser *)",
      "Bash(git push * dev)",
      "Bash(git push origin dev)",
      "Bash(git push *:dev)",
      "Bash(git push * main)",
      "Bash(git push origin main)",
      "Bash(git push *:main)",
      "Bash(find * -exec *)",
      "Bash(find * -execdir *)",
      "Bash(find * -delete*)",
      "Bash(find * -ok *)",
      "Bash(find * -okdir *)",
      "Bash(find -exec *)",
      "Bash(find -execdir *)",
      "Bash(find -delete*)",
      "Bash(find -ok *)",
      "Bash(find -okdir *)"
    ]
  }
}
