{
  "$schema": "https://raw.githubusercontent.com/b-at-neu/port/main/schema/port.config.schema.json",
  "tracker": "github",
  "repo": "b-at-neu/port",
  "branches": {
    "integration": "dev",
    "production": "main"
  },
  "commands": {
    "bootstrap": ["pnpm install"],
    "checks": [{ "run": "node scripts/checks.ts", "fix": null }],
    "artifacts": "node plugins/port/bin/artifacts.mjs",
    "worktrees": "node plugins/port/bin/worktrees.mjs",
    "tick": "node scripts/port-tick.ts"
  },
  "docs": {
    "engineering": "docs/ENGINEERING.md",
    "design": null
  },
  "models": {
    "plan": "opus",
    "impl": "sonnet",
    "review": "sonnet",
    "revise": "sonnet"
  },
  "labels": {},
  "modules": {
    "approvalGate": true,
    "release": true,
    "scope": true
  },
  "release": {
    "versionSource": "package",
    "versionFiles": ["plugins/port/.claude-plugin/plugin.json"],
    "versionCommand": null,
    "postPublishHook": "node scripts/dev-window.ts"
  },
  "reviewCycleCap": 5,
  "concurrency": {
    "sharedFiles": [
      "ARCHITECTURE.md",
      "CONTRIBUTING.md",
      "docs/ENGINEERING.md",
      "docs/TESTING.md",
      "evals/README.md",
      "scripts/checks.ts"
    ],
    "overlapThreshold": 2
  },
  "sessionRequiredPaths": ["CLAUDE.md", ".claude/**"],
  "extraAllow": [
    "Bash(node scripts/checks.ts)",
    "Bash(node scripts/checks.ts *)",
    "Bash(node plugins/port/bin/artifacts.mjs *)",
    "Bash(node plugins/port/bin/worktrees.mjs *)",
    "Bash(node scripts/port-tick.ts *)",
    "Bash(node scripts/dev-window.ts)",
    "Bash(node scripts/dev-window.ts *)"
  ]
}
