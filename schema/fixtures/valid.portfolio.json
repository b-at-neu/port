{
  "$schema": "../port.config.schema.json",
  "repo": "b-at-neu/portfolio",
  "branches": { "integration": "dev", "production": "main" },
  "commands": {
    "bootstrap": ["npm ci"],
    "checks": [{ "run": "npm run lint", "fix": null }],
    "artifacts": "node scripts/port-artifacts.mjs"
  },
  "docs": { "engineering": null, "design": null },
  "concurrency": { "sharedFiles": ["docs/CHANGELOG.md"], "overlapThreshold": 2 },
  "modules": {
    "approvalGate": false,
    "release": false,
    "scope": true
  }
}
