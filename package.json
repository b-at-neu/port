{
  "name": "port-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "imports": {
    "#lib/*": "./scripts/lib/*",
    "#port-tick/*": "./scripts/port-tick/*",
    "#plugins/*": "./plugins/*",
    "#desktop/*": "./apps/desktop/*"
  },
  "scripts": {
    "dev": "pnpm --filter @port/desktop dev",
    "build": "pnpm -r build",
    "dist": "pnpm --filter @port/desktop dist",
    "screenshots": "pnpm --filter @port/desktop screenshots",
    "e2e": "pnpm --filter @port/desktop e2e",
    "typecheck": "pnpm -r typecheck",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^6.0.3"
  }
}
