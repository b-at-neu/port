    { "function": "zeroDiffGate", "name": "same head, no Gate cleared since — escalate", "input": { "reviews": [{ "body": "## Code Review — Cycle 1 · needs revision", "submittedAt": "2026-01-01T00:00:00Z", "commit": { "oid": "sha1" } }], "comments": [], "headRefOid": "sha1" }, "expected": { "action": "escalate" } },
    { "function": "zeroDiffGate", "name": "same head, Gate cleared authorises one more review", "input": { "reviews": [{ "body": "## Code Review — Cycle 1 · needs revision", "submittedAt": "2026-01-01T00:00:00Z", "commit": { "oid": "sha1" } }], "comments": [{ "body": "## Gate cleared", "createdAt": "2026-01-02T00:00:00Z" }], "headRefOid": "sha1" }, "expected": { "action": "dispatch-once" } },

    { "function": "cycleCapExceeded", "name": "below the cap", "input": [[{ "body": "## Code Review — Cycle 1 · needs revision" }, { "body": "## Code Review — Cycle 2 · needs revision" }], 5], "expected": false },
    { "function": "cycleCapExceeded", "name": "at the cap — unconditional, even with a clean latest review", "input": [[{ "body": "## Code Review — Cycle 1 · needs revision" }, { "body": "## Code Review — Cycle 2 · approved" }, { "body": "## Code Review — Cycle 3 · approved" }, { "body": "## Code Review — Cycle 4 · approved" }, { "body": "## Code Review — Cycle 5 · approved" }], 5], "expected": true },

