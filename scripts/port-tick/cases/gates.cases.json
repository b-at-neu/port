    { "function": "approvedReverify", "name": "CONFLICTING refreshes in place, approval stands", "input": { "verdict": { "pending": false, "red": [], "green": ["build"] }, "mergeable": "CONFLICTING" }, "expected": { "action": "refresh-in-place" } },
    { "function": "approvedReverify", "name": "all green and mergeable — announce ready", "input": { "verdict": { "pending": false, "red": [], "green": ["build"] }, "mergeable": "MERGEABLE" }, "expected": { "action": "announce-ready", "green": ["build"] } },
    { "function": "approvedReverify", "name": "still pending — wait", "input": { "verdict": { "pending": true, "red": [], "green": [] }, "mergeable": "MERGEABLE" }, "expected": { "action": "wait" } }
