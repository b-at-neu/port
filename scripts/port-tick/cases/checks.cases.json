{
  "$comment": "Authoritative decision-case table for scripts/port-tick/checks.ts, asserted by scripts/checks/tick.ts (family 14, #292) and ported against by apps/desktop/tests/unit/main/tick/checks.test.ts.",
  "cases": [
    {
      "function": "reduceRollup",
      "name": "the latest entry per name wins",
      "input": [
        { "__typename": "CheckRun", "name": "build", "conclusion": "FAILURE", "status": "COMPLETED", "startedAt": "2026-01-01T00:00:00Z" },
        { "__typename": "CheckRun", "name": "build", "conclusion": "SUCCESS", "status": "COMPLETED", "startedAt": "2026-01-02T00:00:00Z" }
      ],
      "expected": [{ "__typename": "CheckRun", "name": "build", "conclusion": "SUCCESS", "status": "COMPLETED", "startedAt": "2026-01-02T00:00:00Z" }]
    },
    {
      "function": "isConcluded",
      "name": "a still-running CheckRun is not concluded",
      "input": { "__typename": "CheckRun", "status": "IN_PROGRESS" },
      "expected": false
    },
    {
      "function": "rollupVerdict",
      "name": "an empty rollup is pending",
      "input": [{ "contexts": { "nodes": [] } }, {}],
      "expected": { "pending": true, "red": [], "green": [], "excused": [], "unmatched": [] }
    },
    {
      "function": "rollupVerdict",
      "name": "a red blocking check",
      "input": [{ "contexts": { "nodes": [{ "__typename": "CheckRun", "name": "build", "conclusion": "FAILURE", "status": "COMPLETED" }] } }, {}],
      "expected": { "pending": false, "red": [{ "name": "build", "conclusion": "FAILURE" }], "green": [], "excused": [], "unmatched": [] }
    },
    {
      "function": "rollupVerdict",
      "name": "an excused infrastructure red check never blocks",
      "input": [
        {
          "contexts": {
            "nodes": [
              { "__typename": "CheckRun", "name": "build", "conclusion": "FAILURE", "status": "COMPLETED" },
              { "__typename": "CheckRun", "name": "approval-gate", "conclusion": "FAILURE", "status": "COMPLETED" }
            ]
          }
        },
        { "approval-gate": { "disposition": "infrastructure", "source": "approval-gate" } }
      ],
      "expected": {
        "pending": false,
        "red": [{ "name": "build", "conclusion": "FAILURE" }],
        "green": [],
        "excused": [{ "name": "approval-gate", "conclusion": "FAILURE", "source": "approval-gate" }],
        "unmatched": []
      }
    },
    {
      "function": "rollupVerdict",
      "name": "zero evidence — every entry excused",
      "input": [
        { "contexts": { "nodes": [{ "__typename": "CheckRun", "name": "approval-gate", "conclusion": "FAILURE", "status": "COMPLETED" }] } },
        { "approval-gate": { "disposition": "infrastructure", "source": "approval-gate" } }
      ],
      "expected": { "pending": true, "zeroEvidence": true, "red": [], "green": [], "excused": [{ "name": "approval-gate", "conclusion": "FAILURE", "source": "approval-gate" }], "unmatched": [] }
    },
    {
      "function": "rollupVerdict",
      "name": "an unmatched disposition is reported, never satisfied",
      "input": [
        { "contexts": { "nodes": [{ "__typename": "CheckRun", "name": "build", "conclusion": "SUCCESS", "status": "COMPLETED" }] } },
        { "deploy": { "disposition": "infrastructure", "source": "CLAUDE.md" } }
      ],
      "expected": { "pending": false, "red": [], "green": ["build"], "excused": [], "unmatched": ["deploy"] }
    },
    {
      "function": "integrationChecksOf",
      "name": "the newest commit's concluded entry decides each check",
      "input": [
        { "statusCheckRollup": { "contexts": { "nodes": [{ "__typename": "CheckRun", "name": "test", "status": "COMPLETED", "conclusion": "FAILURE", "startedAt": "2026-01-02T00:00:00Z" }] } } },
        { "statusCheckRollup": { "contexts": { "nodes": [{ "__typename": "CheckRun", "name": "test", "status": "COMPLETED", "conclusion": "SUCCESS", "startedAt": "2026-01-01T00:00:00Z" }, { "__typename": "CheckRun", "name": "lint", "status": "COMPLETED", "conclusion": "SUCCESS", "startedAt": "2026-01-01T00:00:00Z" }] } } }
      ],
      "expected": { "test": "red", "lint": "green" }
    },
    {
      "function": "integrationChecksOf",
      "name": "a pending newest entry defers to the latest concluded one",
      "input": [
        { "statusCheckRollup": { "contexts": { "nodes": [{ "__typename": "CheckRun", "name": "test", "status": "IN_PROGRESS", "conclusion": null, "startedAt": "2026-01-02T00:00:00Z" }] } } },
        { "statusCheckRollup": { "contexts": { "nodes": [{ "__typename": "CheckRun", "name": "test", "status": "COMPLETED", "conclusion": "FAILURE", "startedAt": "2026-01-01T00:00:00Z" }] } } }
      ],
      "expected": { "test": "red" }
    },
    {
      "function": "integrationChecksOf",
      "name": "a commit with no rollup contributes nothing",
      "input": [{ "statusCheckRollup": null }, { "statusCheckRollup": { "contexts": { "nodes": [{ "__typename": "StatusContext", "context": "ci/legacy", "state": "SUCCESS", "createdAt": "2026-01-01T00:00:00Z" }] } } }],
      "expected": { "ci/legacy": "green" }
    },
    {
      "function": "integrationChecksOf",
      "name": "an absent history is unreadable, never an empty read",
      "input": null,
      "expected": null
    },
    { "function": "actionsJobOf", "name": "an Actions job URL names its run and job", "input": "https://github.com/o/r/actions/runs/111/job/222", "expected": { "runId": "111", "jobId": "222" } },
    { "function": "actionsJobOf", "name": "an external CI URL is not rerunnable", "input": "https://ci.example.test/builds/9", "expected": null },
    { "function": "actionsJobOf", "name": "an absent URL is not rerunnable", "input": null, "expected": null },
    {
      "function": "preReviewRerun",
      "name": "the first red Actions check gets a rerun",
      "input": { "contexts": [{ "__typename": "CheckRun", "name": "test", "status": "COMPLETED", "conclusion": "FAILURE", "startedAt": "2026-01-01T00:00:00Z", "detailsUrl": "https://github.com/o/r/actions/runs/111/job/222" }], "dispositions": {}, "headRefOid": "sha1", "now": "2026-01-01T01:00:00Z" },
      "expected": { "action": "rerun", "checks": ["test"], "runs": [{ "check": "test", "runId": "111" }] }
    },
    {
      "function": "preReviewRerun",
      "name": "two red jobs of one run share one rerun command",
      "input": { "contexts": [{ "__typename": "CheckRun", "name": "test", "status": "COMPLETED", "conclusion": "FAILURE", "startedAt": "2026-01-01T00:00:00Z", "detailsUrl": "https://github.com/o/r/actions/runs/111/job/222" }, { "__typename": "CheckRun", "name": "lint", "status": "COMPLETED", "conclusion": "FAILURE", "startedAt": "2026-01-01T00:00:00Z", "detailsUrl": "https://github.com/o/r/actions/runs/111/job/223" }], "dispositions": {}, "headRefOid": "sha1", "now": "2026-01-01T01:00:00Z" },
      "expected": { "action": "rerun", "checks": ["test", "lint"], "runs": [{ "check": "test", "runId": "111" }] }
    },
    {
      "function": "preReviewRerun",
      "name": "rerun recorded, the old entry still shown inside the window — hold",
      "input": { "contexts": [{ "__typename": "CheckRun", "name": "test", "status": "COMPLETED", "conclusion": "FAILURE", "startedAt": "2026-01-01T00:00:00Z", "detailsUrl": "https://github.com/o/r/actions/runs/111/job/222" }], "dispositions": {}, "headRefOid": "sha1", "reran": { "sha": "sha1", "checks": { "test": "2026-01-01T01:00:00.000Z" } }, "now": "2026-01-01T01:05:00Z" },
      "expected": { "action": "hold", "checks": ["test"] }
    },
    {
      "function": "preReviewRerun",
      "name": "rerun recorded, the old entry past the window — proceed",
      "input": { "contexts": [{ "__typename": "CheckRun", "name": "test", "status": "COMPLETED", "conclusion": "FAILURE", "startedAt": "2026-01-01T00:00:00Z", "detailsUrl": "https://github.com/o/r/actions/runs/111/job/222" }], "dispositions": {}, "headRefOid": "sha1", "reran": { "sha": "sha1", "checks": { "test": "2026-01-01T01:00:00.000Z" } }, "now": "2026-01-01T01:10:00Z" },
      "expected": { "action": "proceed" }
    },
    {
      "function": "preReviewRerun",
      "name": "rerun recorded, no clock — never holds on visibility",
      "input": { "contexts": [{ "__typename": "CheckRun", "name": "test", "status": "COMPLETED", "conclusion": "FAILURE", "startedAt": "2026-01-01T00:00:00Z", "detailsUrl": "https://github.com/o/r/actions/runs/111/job/222" }], "dispositions": {}, "headRefOid": "sha1", "reran": { "sha": "sha1", "checks": { "test": "2026-01-01T01:00:00.000Z" } }, "now": null },
      "expected": { "action": "proceed" }
    },
    {
      "function": "preReviewRerun",
      "name": "rerun recorded and now pending — hold",
      "input": { "contexts": [{ "__typename": "CheckRun", "name": "test", "status": "IN_PROGRESS", "conclusion": null, "startedAt": "2026-01-01T01:01:00Z", "detailsUrl": "https://github.com/o/r/actions/runs/111/job/222" }], "dispositions": {}, "headRefOid": "sha1", "reran": { "sha": "sha1", "checks": { "test": "2026-01-01T01:00:00.000Z" } }, "now": "2026-01-01T03:00:00Z" },
      "expected": { "action": "hold", "checks": ["test"] }
    },
    {
      "function": "preReviewRerun",
      "name": "rerun concluded red — proceed, never a second rerun",
      "input": { "contexts": [{ "__typename": "CheckRun", "name": "test", "status": "COMPLETED", "conclusion": "FAILURE", "startedAt": "2026-01-01T01:01:00Z", "detailsUrl": "https://github.com/o/r/actions/runs/111/job/222" }], "dispositions": {}, "headRefOid": "sha1", "reran": { "sha": "sha1", "checks": { "test": "2026-01-01T01:00:00.000Z" } }, "now": "2026-01-01T01:05:00Z" },
      "expected": { "action": "proceed" }
    },
    {
      "function": "preReviewRerun",
      "name": "a rerun recorded on a different head does not count — rerun again",
      "input": { "contexts": [{ "__typename": "CheckRun", "name": "test", "status": "COMPLETED", "conclusion": "FAILURE", "startedAt": "2026-01-01T00:00:00Z", "detailsUrl": "https://github.com/o/r/actions/runs/111/job/222" }], "dispositions": {}, "headRefOid": "sha2", "reran": { "sha": "sha1", "checks": { "test": "2026-01-01T00:30:00.000Z" } }, "now": "2026-01-01T01:00:00Z" },
      "expected": { "action": "rerun", "checks": ["test"], "runs": [{ "check": "test", "runId": "111" }] }
    },
    {
      "function": "preReviewRerun",
      "name": "a red StatusContext cannot be rerun — proceed",
      "input": { "contexts": [{ "__typename": "StatusContext", "context": "ci/legacy", "state": "FAILURE", "createdAt": "2026-01-01T00:00:00Z", "targetUrl": "https://github.com/o/r/actions/runs/111/job/222" }], "dispositions": {}, "headRefOid": "sha1", "now": "2026-01-01T01:00:00Z" },
      "expected": { "action": "proceed" }
    },
    {
      "function": "preReviewRerun",
      "name": "a red history-derived check is never rerun — proceed",
      "input": { "contexts": [{ "__typename": "CheckRun", "name": "audit-artifacts", "status": "COMPLETED", "conclusion": "FAILURE", "startedAt": "2026-01-01T00:00:00Z", "detailsUrl": "https://github.com/o/r/actions/runs/111/job/222" }], "dispositions": { "audit-artifacts": { "disposition": "blocking", "source": "artifacts-audit" } }, "headRefOid": "sha1", "now": "2026-01-01T01:00:00Z" },
      "expected": { "action": "proceed" }
    },
    {
      "function": "preReviewRerun",
      "name": "a red infrastructure check is never rerun — proceed",
      "input": { "contexts": [{ "__typename": "CheckRun", "name": "approval-check", "status": "COMPLETED", "conclusion": "FAILURE", "startedAt": "2026-01-01T00:00:00Z", "detailsUrl": "https://github.com/o/r/actions/runs/111/job/222" }], "dispositions": { "approval-check": { "disposition": "infrastructure", "source": "approval-gate" } }, "headRefOid": "sha1", "now": "2026-01-01T01:00:00Z" },
      "expected": { "action": "proceed" }
    },
    {
      "function": "preReviewRerun",
      "name": "all green — proceed",
      "input": { "contexts": [{ "__typename": "CheckRun", "name": "test", "status": "COMPLETED", "conclusion": "SUCCESS", "startedAt": "2026-01-01T00:00:00Z", "detailsUrl": "https://github.com/o/r/actions/runs/111/job/222" }], "dispositions": {}, "headRefOid": "sha1", "now": "2026-01-01T01:00:00Z" },
      "expected": { "action": "proceed" }
    },
    {
      "function": "historyDerivedChecks",
      "name": "only blocking artifacts-audit entries are history-derived",
      "input": { "audit-artifacts": { "disposition": "blocking", "source": "artifacts-audit" }, "approval-check": { "disposition": "infrastructure", "source": "approval-gate" }, "audit-x": { "disposition": "infrastructure", "source": "artifacts-audit" } },
      "expected": ["audit-artifacts"]
    }
  ]
}
