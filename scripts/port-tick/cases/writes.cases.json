    { "function": "approvalWithdrawnWrite", "name": "red check withdraws approval", "input": { "repo": "o/r", "labels": { "approved": "approved", "needsRevision": "needs revision" }, "number": 14 }, "expected": { "command": "gh pr edit 14 --repo o/r --remove-label \"approved\" --add-label \"needs revision\"", "why": "approval withdrawn: red check" } },

    { "function": "livenessResetWrite", "name": "liveness reset back to the trigger label", "input": { "repo": "o/r", "item": 15, "from": "in progress", "to": "plan approved" }, "expected": { "command": "gh issue edit 15 --repo o/r --remove-label \"in progress\" --add-label \"plan approved\"", "why": "liveness reset: in progress → plan approved" } },

    { "function": "gateResolveWrite", "name": "plan review: approved", "input": { "repo": "o/r", "labels": { "planReview": "plan review", "planApproved": "plan approved", "planChangesRequested": "plan changes requested", "needsHuman": "needs human", "needsRevision": "needs revision", "readyForReview": "ready for review" }, "item": 16, "decision": "approve" }, "expected": { "command": "gh issue edit 16 --repo o/r --remove-label \"plan review\" --add-label \"plan approved\"", "why": "plan review: approved" } },
    { "function": "gateResolveWrite", "name": "plan review: changes requested", "input": { "repo": "o/r", "labels": { "planReview": "plan review", "planApproved": "plan approved", "planChangesRequested": "plan changes requested", "needsHuman": "needs human", "needsRevision": "needs revision", "readyForReview": "ready for review" }, "item": 17, "decision": "changes" }, "expected": { "command": "gh issue edit 17 --repo o/r --remove-label \"plan review\" --add-label \"plan changes requested\"", "why": "plan review: changes requested" } },
    { "function": "gateResolveWrite", "name": "gate cleared: back to revision", "input": { "repo": "o/r", "labels": { "planReview": "plan review", "planApproved": "plan approved", "planChangesRequested": "plan changes requested", "needsHuman": "needs human", "needsRevision": "needs revision", "readyForReview": "ready for review" }, "item": 18, "decision": "back-to-revision" }, "expected": { "command": "gh pr edit 18 --repo o/r --remove-label \"needs human\" --add-label \"needs revision\"", "why": "gate cleared: back to revision" } },
