{
  "$comment": "Authoritative decision-case table for scripts/port-tick/writes.mjs — the gh command strings the tick engine emits. Pins #225's fix: the refresh sweep's asymmetry (add-only on both paths) and the escalation write removing whichever trigger the item actually carries.",
  "cases": [
    { "function": "refreshSweepWrite", "name": "readyForReview ∩ CONFLICTING refreshes — add only, no remove", "input": { "repo": "o/r", "labels": { "refreshBranch": "refresh branch", "readyForReview": "ready for review", "approved": "approved", "needsHuman": "needs human" }, "candidate": { "number": 5, "sourceLabelKey": "readyForReview" }, "decision": { "action": "refresh", "count": 1 } }, "expected": { "command": "gh pr edit 5 --repo o/r --add-label \"refresh branch\"", "why": "refresh sweep: rebase + force-push, no code changes" } },
    { "function": "refreshSweepWrite", "name": "approved ∩ CONFLICTING refreshes — add only, approval untouched", "input": { "repo": "o/r", "labels": { "refreshBranch": "refresh branch", "readyForReview": "ready for review", "approved": "approved", "needsHuman": "needs human" }, "candidate": { "number": 6, "sourceLabelKey": "approved" }, "decision": { "action": "refresh", "count": 1 } }, "expected": { "command": "gh pr edit 6 --repo o/r --add-label \"refresh branch\"", "why": "refresh sweep: rebase + force-push, no code changes" } },
    { "function": "refreshSweepWrite", "name": "escalation from readyForReview removes ready for review, not approved", "input": { "repo": "o/r", "labels": { "refreshBranch": "refresh branch", "readyForReview": "ready for review", "approved": "approved", "needsHuman": "needs human" }, "candidate": { "number": 7, "sourceLabelKey": "readyForReview" }, "decision": { "action": "escalate", "reason": "same-sha", "count": 1 } }, "expected": { "command": "gh pr edit 7 --repo o/r --remove-label \"ready for review\" --add-label \"needs human\"", "why": "refresh sweep: same-sha" } },
    { "function": "refreshSweepWrite", "name": "escalation from approved removes approved", "input": { "repo": "o/r", "labels": { "refreshBranch": "refresh branch", "readyForReview": "ready for review", "approved": "approved", "needsHuman": "needs human" }, "candidate": { "number": 8, "sourceLabelKey": "approved" }, "decision": { "action": "escalate", "reason": "consecutive-cap", "count": 4 } }, "expected": { "command": "gh pr edit 8 --repo o/r --remove-label \"approved\" --add-label \"needs human\"", "why": "refresh sweep: consecutive-cap" } },

    { "function": "zeroDiffWrite", "name": "zero-diff escalation", "input": { "repo": "o/r", "labels": { "readyForReview": "ready for review", "needsHuman": "needs human" }, "number": 12 }, "expected": { "command": "gh pr edit 12 --repo o/r --remove-label \"ready for review\" --add-label \"needs human\"", "why": "zero-diff review gate" } },

