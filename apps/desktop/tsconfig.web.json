{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "../..",
    "types": ["vite/client"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/types/**/*",
    "src/utils/**/*",
    "src/shared/**/*",
    "src/preload/index.d.ts",
    "tests/unit/renderer/**/*",
    "tests/unit/utils/**/*",
    "tests/fixtures/stage-session.ts",
    "../../scripts/port-tick/liveness.ts",
    "../../scripts/port-tick/overrides.ts",
    "../../scripts/port-tick/gates.ts"
  ]
}
