{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "../..",
    "types": ["vite/client", "node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "#app-route": ["./src/main/platform/route.ts"]
    }
  },
  "exclude": ["src/main/index.ts"],
  "include": [
    "src/renderer/**/*",
    "src/main/**/*",
    "src/types/**/*",
    "src/utils/**/*",
    "src/shared/**/*",
    "src/preload/index.d.ts",
    "tests/unit/renderer/**/*",
    "tests/unit/utils/**/*",
    "tests/fixtures/stage-session.ts",
    "tests/fixtures/board-state.ts"
  ]
}
