{
  "classifyCandidate": [
    { "name": "outside is fenced off whatever else is true", "input": { "isOutside": true, "isProtected": false, "locked": true, "dirty": true, "itemState": "MERGED", "isAncestor": true }, "expect": { "state": "outside", "removable": false, "otherwiseRemovable": false } },
    { "name": "outside beats protected", "input": { "isOutside": true, "isProtected": true, "locked": false, "dirty": false, "itemState": null, "isAncestor": null }, "expect": { "state": "outside", "removable": false, "otherwiseRemovable": false } },
    { "name": "protected is active even when its item is merged", "input": { "isOutside": false, "isProtected": true, "locked": false, "dirty": false, "itemState": "MERGED", "isAncestor": null }, "expect": { "state": "active", "removable": false, "otherwiseRemovable": false } },
    { "name": "an open item is active", "input": { "isOutside": false, "isProtected": false, "locked": false, "dirty": false, "itemState": "OPEN", "isAncestor": null }, "expect": { "state": "active", "removable": false, "otherwiseRemovable": false } },
    { "name": "an open item stays active even when HEAD is an ancestor", "input": { "isOutside": false, "isProtected": false, "locked": false, "dirty": false, "itemState": "OPEN", "isAncestor": true }, "expect": { "state": "active", "removable": false, "otherwiseRemovable": false } },
    { "name": "a merged item is done and removable", "input": { "isOutside": false, "isProtected": false, "locked": false, "dirty": false, "itemState": "MERGED", "isAncestor": null }, "expect": { "state": "done", "removable": true, "otherwiseRemovable": true } },
    { "name": "a closed item is done and removable", "input": { "isOutside": false, "isProtected": false, "locked": false, "dirty": false, "itemState": "CLOSED", "isAncestor": false }, "expect": { "state": "done", "removable": true, "otherwiseRemovable": true } },
    { "name": "no item and an ancestor HEAD is no-work", "input": { "isOutside": false, "isProtected": false, "locked": false, "dirty": false, "itemState": null, "isAncestor": true }, "expect": { "state": "no-work", "removable": true, "otherwiseRemovable": true } },
    { "name": "no item and a non-ancestor HEAD is unresolved", "input": { "isOutside": false, "isProtected": false, "locked": false, "dirty": false, "itemState": null, "isAncestor": false }, "expect": { "state": "unresolved", "removable": false, "otherwiseRemovable": false } },
    { "name": "no item and an unknown ancestry is unresolved", "input": { "isOutside": false, "isProtected": false, "locked": false, "dirty": false, "itemState": null, "isAncestor": null }, "expect": { "state": "unresolved", "removable": false, "otherwiseRemovable": false } },
    { "name": "a locked finished worktree is locked but otherwise removable", "input": { "isOutside": false, "isProtected": false, "locked": true, "dirty": false, "itemState": "MERGED", "isAncestor": null }, "expect": { "state": "locked", "removable": false, "otherwiseRemovable": true } },
    { "name": "a locked live worktree is locked and not otherwise removable", "input": { "isOutside": false, "isProtected": false, "locked": true, "dirty": false, "itemState": "OPEN", "isAncestor": null }, "expect": { "state": "locked", "removable": false, "otherwiseRemovable": false } },
    { "name": "a locked unresolved worktree is locked and not otherwise removable", "input": { "isOutside": false, "isProtected": false, "locked": true, "dirty": false, "itemState": null, "isAncestor": null }, "expect": { "state": "locked", "removable": false, "otherwiseRemovable": false } },
    { "name": "locked beats dirty", "input": { "isOutside": false, "isProtected": false, "locked": true, "dirty": true, "itemState": "MERGED", "isAncestor": null }, "expect": { "state": "locked", "removable": false, "otherwiseRemovable": true } },
    { "name": "a dirty finished worktree is dirty but otherwise removable", "input": { "isOutside": false, "isProtected": false, "locked": false, "dirty": true, "itemState": "MERGED", "isAncestor": null }, "expect": { "state": "dirty", "removable": false, "otherwiseRemovable": true } },
    { "name": "a dirty no-work worktree is dirty but otherwise removable", "input": { "isOutside": false, "isProtected": false, "locked": false, "dirty": true, "itemState": null, "isAncestor": true }, "expect": { "state": "dirty", "removable": false, "otherwiseRemovable": true } },
    { "name": "a dirty live worktree stays active", "input": { "isOutside": false, "isProtected": false, "locked": false, "dirty": true, "itemState": "OPEN", "isAncestor": null }, "expect": { "state": "active", "removable": false, "otherwiseRemovable": false } },
    { "name": "a dirty unresolved worktree stays unresolved", "input": { "isOutside": false, "isProtected": false, "locked": false, "dirty": true, "itemState": null, "isAncestor": false }, "expect": { "state": "unresolved", "removable": false, "otherwiseRemovable": false } }
