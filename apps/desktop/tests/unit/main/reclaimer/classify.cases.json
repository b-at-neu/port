    { "name": "a vanished directory is done even while still registered", "input": { "dirExists": false, "stillRegistered": true, "headNow": "bbb", "headClassified": "aaa" }, "expect": { "action": "done" } },
    { "name": "a deregistered directory still on disk falls back", "input": { "dirExists": true, "stillRegistered": false, "headNow": null, "headClassified": "aaa" }, "expect": { "action": "fallback" } },
    { "name": "a registered directory with an unmoved HEAD falls back", "input": { "dirExists": true, "stillRegistered": true, "headNow": "aaa", "headClassified": "aaa" }, "expect": { "action": "fallback" } },
    { "name": "a registered directory whose HEAD moved aborts", "input": { "dirExists": true, "stillRegistered": true, "headNow": "bbb", "headClassified": "aaa" }, "expect": { "action": "abort", "reason": "changed during removal" } },
    { "name": "a registered directory that lost its HEAD aborts", "input": { "dirExists": true, "stillRegistered": true, "headNow": null, "headClassified": "aaa" }, "expect": { "action": "abort", "reason": "changed during removal" } }
  ],
  "orphanVerdict": [
    { "name": "a .git directory is a live repository", "input": { "gitEntry": "dir", "gitdirTargetExists": false }, "expect": "skip" },
    { "name": "an unreadable .git entry is skipped", "input": { "gitEntry": "unreadable", "gitdirTargetExists": false }, "expect": "skip" },
    { "name": "a .git file whose target exists is a live worktree", "input": { "gitEntry": "file", "gitdirTargetExists": true }, "expect": "skip" },
    { "name": "a .git file whose target is gone is an orphan", "input": { "gitEntry": "file", "gitdirTargetExists": false }, "expect": "orphan" },
    { "name": "a directory with no .git entry is an orphan", "input": { "gitEntry": "none", "gitdirTargetExists": false }, "expect": "orphan" }
  ],
  "classifyRemovalFailure": [
