{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "../..",
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "#app-fixtures": ["./tests/fixtures/app/index.ts"],
      "#app-route": ["./src/main/platform/route.ts"]
    }
  },
  "include": [
    "scripts/display.d.mts",
    "eslint/*.d.mts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/renderer/router/routes.ts",
    "src/renderer/local/inspect.ts",
    "src/renderer/local/shape.ts",
    "src/renderer/board/blocked-on.ts",
    "src/renderer/board/dispatch-failures.ts",
    "src/renderer/board/needs-you.ts",
    "src/renderer/board/project.ts",
    "src/renderer/board/stage-links.ts",
    "src/renderer/board/tick.ts",
    "src/types/**/*",
    "src/utils/**/*",
    "tests/unit/eslint/**/*",
    "tests/unit/main/**/*",
    "tests/unit/preload/**/*",
    "tests/unit/scripts/**/*",
    "tests/unit/utils/**/*",
    "tests/fixtures/**/*",
    "tests/support/**/*",
    "tests/visual/**/*",
    "tests/smoke/**/*",
    "tests/e2e/**/*"
  ]
}
