{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "../..",
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/renderer/local/inspect.ts",
    "src/renderer/local/shape.ts",
    "src/renderer/board/needs-you.ts",
    "src/renderer/board/project.ts",
    "src/renderer/board/stage-links.ts",
    "src/types/**/*",
    "src/utils/**/*",
    "src/testing/**/*",
    "tests/visual/**/*",
    "tests/smoke/**/*",
    "../../scripts/port-tick/gates.ts",
    "../../scripts/port-tick/contention.ts",
    "../../scripts/port-tick/checks.ts",
    "../../scripts/port-tick/liveness.ts",
    "../../scripts/port-tick/classify.ts",
    "../../scripts/port-tick/overrides.ts",
    "../../scripts/port-tick/wire.ts"
  ]
}
