{
  "name": "@port/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Desktop cockpit for the port pipeline. Runs your own installed Claude Code under your own account.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/ensure-electron.mjs && electron-vite dev",
    "build": "electron-vite build",
    "dist": "node scripts/icon.mjs && electron-vite build && electron-builder --config electron-builder.config.mjs --publish never && node scripts/audit-bundle.mjs",
    "screenshots": "electron-vite build && node scripts/screenshots.mjs",
    "smoke:packaged": "node scripts/screenshots.mjs --config playwright.packaged.config.mts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@radix-ui/react-alert-dialog": "^1.1.16",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@types/node": "^26.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "highlight.js": "^11.11.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.51.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.261",
    "@radix-ui/react-collapsible": "^1.1.21",
    "ajv": "^8.20.0",
    "cmdk": "^1.1.1",
    "sonner": "^2.0.8"
  }
}
